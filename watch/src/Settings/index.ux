  text-align: center;
}
.edit-box {
  width: 336px;
  height: 96px;
  padding-left: 16px;
  padding-right: 16px;
  padding-top: 12px;
  padding-bottom: 8px;
  background-color: #262626;
  flex-direction: column;
}
.edit-text {
  width: 304px;
  font-size: 24px;
