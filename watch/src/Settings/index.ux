  width: 280px;
  height: 62px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.label-danger {
  width: 280px;
  font-size: 20px;
  color: #ff6b5e;
  text-align: center;
}
.about {
  width: 308px;
  margin-left: 14px;
  margin-top: 18px;
  font-size: 17px;
  color: #888888;
  text-align: center;
}
.about2 {
  width: 308px;
  margin-left: 14px;
  margin-top: 6px;
  font-size: 15px;
  color: #666666;
  text-align: center;
}
.edit-head {
  width: 336px;
  height: 56px;
  flex-direction: row;
  align-items: center;
  padding-left: 14px;
  padding-right: 14px;
  background-color: #000000;
  border-bottom-width: 1px;
  border-bottom-color: #333333;
}
.eh-btn {
  width: 70px;
