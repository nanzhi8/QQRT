<template>
  <div class="page" style="height:{{vh}}px">
      <div class="head">
        <text class="h-back" @click="goBack">‹</text>
        <text class="h-title">设置</text>
          <text class="h-right">v4.12.1</text>
      </div>

    <scroll class="main" scroll-y="true" style="height:{{contentH}}px">
      <div class="card">
        <div class="row" @click="editHost">
          <text class="label">服务器</text>
          <text class="value">{{hostDisp}}</text>
          <text class="arrow">›</text>
        </div>
        <div class="row">
          <text class="label">账号</text>
          <text class="value">{{account}}</text>
        </div>
        <div class="row">
          <text class="label">机器人</text>
          <text class="value">{{botText}}</text>
        </div>
      </div>

      <div class="card">
        <div class="row" @click="openRequests">
          <text class="label">好友 / 群请求</text>
          <text class="value">{{pendingText}}</text>
          <text class="arrow">›</text>
        </div>
        <div class="row" @click="refreshNames">
          <text class="label">刷新会话名称</text>
          <text class="value">{{nameText}}</text>
        </div>
        <div class="row" @click="clearCursor">
          <text class="label">重置同步进度</text>
          <text class="value">{{cursorText}}</text>
        </div>
        <div class="row" @click="openDevice">
          <text class="label">设备与网络</text>
          <text class="value">{{netText}}</text>
          <text class="arrow">›</text>
        </div>
      </div>

      <div class="card">
        <div class="row-danger" @click="logout">
          <text class="label-danger">退出登录</text>
        </div>
      </div>

      <text class="about">QQRT · 手环 10 Pro / Watch S5 适配版</text>
      <text class="about2">文字聊天 / 群管理 / 撤回 / eSIM 直连</text>
    </scroll>


  </div>
</template>

<script>
import {
  loadAuth, hasAuth, get, post, replace, go, back, toast, saveHost,
  sget, sset, normHost, getHost, getAccount, clearLogin, clearRememberedLogin, isShortCode, resolveShortCode,
  getDeviceSnapshot
} from '../common/api.js'

export default {
  private: {
    vh: 480,
    host: '',
    hostDisp: '未设置',
    account: '未登录',
    botText: '—',
    pendingText: '',
    cursorText: '',
    netText: '',
    contentH: 424
  },

  onInit() {
    this.vh = (typeof global !== 'undefined' && global.designH) || 480
    this.contentH = Math.max(120, this.vh - 56)
    const hint = getDeviceSnapshot().netHint
    this.netText = hint === 'native' ? '可直连' : (hint === 'proxy' ? '需代理' : '查看')
    loadAuth(() => {
      if (!hasAuth()) { replace('Login'); return }
      this.host = getHost()
      this.hostDisp = String(this.host || '').replace(/^https?:\/\//, '')
      this.account = getAccount() || '已登录'
      this.loadStatus()
      this.loadPending()
      sget('qq_sync_after', (v) => {
        this.cursorText = v ? ('#' + v) : '未同步'
      })
    })
  },

  loadStatus() {
    get('/api/watch/status', {}, (err, obj) => {
      if (err) { this.botText = '获取失败'; return }
      const bot = (obj && obj.bot) || {}
      if (bot.connected === true) this.botText = '在线'
      else if (bot.status === 'connecting') this.botText = '连接中'
      else if (bot.hasCredentials) this.botText = '离线'
      else this.botText = '未绑定'
    })
  },

  loadPending() {
    get('/api/watch/requests', {}, (err, obj) => {
      if (err) return
      const n = Number((obj && obj.pendingCount) || 0)
      this.pendingText = n > 0 ? (n + ' 条待处理') : ''
    })
  },

  onShow() {
    const r = typeof global !== 'undefined' ? global.__imeResult : null
    if (!r) return
    global.__imeResult = null
    if (!r.confirmed) return
    const v = String(r.text || '').trim()
    if (!v) return
    if (isShortCode(v)) {
      toast('正在解析短码…')
      resolveShortCode(v, (err, url) => {
        if (err) { toast(err.message); return }
        this.applyHost(url)
      })
      return
    }
    this.applyHost(v)
  },

  editHost() {
    if (typeof global !== 'undefined') global.__imeText = this.host || ''
    if (typeof global !== 'undefined') {
      global.__imeLabel = '服务器地址'
      global.__imeResult = null
    }
    go('Ime')
  },

  applyHost(v) {
    const h = normHost(v)
    const changed = this.host && this.host !== h
    const save = () => {
      this.host = h
      this.hostDisp = String(h || '').replace(/^https?:\/\//, '')
      saveHost(h, (err) => {
        if (err) { toast(err.message); return }
        toast('已保存，需重新登录')
      })
    }
    if (changed) {
      clearRememberedLogin((err) => {
        if (err) { toast('旧服务器凭据未能清除'); return }
        save()
      })
      return
    }
    save()
  },

  openRequests() {
    go('Requests')
  },

  openDevice() {
    go('Device')
  },

  refreshNames() {
    this.nameText = '刷新中…'
    post('/api/watch/refresh-names', {}, (err, obj) => {
      if (err) { this.nameText = '失败'; toast(err.msg || '刷新失败'); return }
      const n = Number((obj && obj.updated) || 0)
      this.nameText = n > 0 ? ('已更新 ' + n + ' 个') : '已是最新'
      toast(n > 0 ? ('已更新 ' + n + ' 个会话名称') : '名称已是最新')
    })
  },

  clearCursor() {
    sset('qq_sync_after', '')
    this.cursorText = '未同步'
    toast('已重置')
  },

  logout() {
    clearRememberedLogin((rememberErr) => {
      if (rememberErr) { toast('清除已保存凭据失败'); return }
      clearLogin((tokenErr) => {
        if (tokenErr) { toast('清除登录状态失败'); return }
        replace('Login')
      })
    })
  },

  goBack() {
    back()
  }
}
</script>

