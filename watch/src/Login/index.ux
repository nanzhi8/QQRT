.scroll {
  width: 336px;
  flex-direction: column;
}
.page {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}
.hero {
  width: 336px;
  height: 158px;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 14px;
}
.logo {
  width: 62px;
  height: 62px;
  border-radius: 20px;
  background-color: #3184d0;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
}
.logo-t {
  font-size: 36px;
  color: #ffffff;
  font-weight: bold;
}
.title {
  font-size: 34px;
  color: #ffffff;
  font-weight: bold;
  height: 40px;
}
.sub {
  font-size: 19px;
  color: #aaaaaa;
  height: 24px;
}
.form {
  width: 300px;
  flex-direction: column;
  margin-top: 6px;
}
.field {
  width: 300px;
  height: 62px;
  background-color: #262626;
  border-radius: 100px;
  border-width: 2px;
  border-color: rgba(255, 255, 255, 0.06);
  flex-direction: row;
  align-items: center;
  padding-left: 20px;
  padding-right: 20px;
  margin-bottom: 10px;
}
.flabel {
  width: 74px;
  font-size: 20px;
  color: #aaaaaa;
}
.fvalue {
  flex-grow: 1;
  font-size: 22px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.fvalue-ph {
  flex-grow: 1;
  font-size: 22px;
  color: #888888;
  lines: 1;
  text-overflow: ellipsis;
}
.btn {
  width: 300px;
  height: 62px;
  margin-top: 8px;
  border-radius: 100px;
  background-color: #3184d0;
  align-items: center;
  justify-content: center;
}
.btn-t {
  font-size: 25px;
  color: #ffffff;
  font-weight: bold;
}
.err {
  width: 300px;
  font-size: 19px;
  color: #ff6b6b;
  text-align: center;
  margin-top: 12px;
  lines: 2;
}
.tip {
  width: 300px;
  font-size: 17px;
  color: #888888;
  text-align: center;
  margin-top: 10px;
}

</style>
