<template>
  <div class="page" style="height:{{vh}}px">
    <div class="head">
      <text class="h-back" @click="backOne">‹</text>
      <div class="h-mid">
        <text class="h-title">{{title}}</text>
        <text class="h-ver">{{subtitle}}</text>
      </div>
      <text class="h-right" @click="goBack">退出</text>
    </div>

    <div class="selbar" if="{{selText}}">
      <text class="sel-t">{{selText}}</text>
    </div>

    <div class="tip" if="{{busy}}">
      <text class="tip-t">处理中…</text>
    </div>

    <list class="menu" if="{{view === 'groups'}}" style="height:{{listH}}px">
      <list-item type="g" class="cell" for="{{groups}}" @click="openGroup($item)">
        <text class="cell-t">{{$item.label}}</text>
        <text class="cell-s">{{$item.desc}}</text>
      </list-item>
      <list-item type="g2" class="cell" @click="goBack">
        <text class="cell-t">‹ 返回聊天</text>
        <text class="cell-s">群管理只影响当前这个群</text>
      </list-item>
    </list>

    <list class="menu" if="{{view === 'items'}}" style="height:{{listH}}px">
      <list-item type="i" class="cell" for="{{items}}" @click="tapItem($item)">
        <text class="cell-t">{{$item.label}}</text>
        <text class="cell-s">{{$item.hint}}</text>
      </list-item>
      <list-item type="i2" class="cell" @click="backOne">
        <text class="cell-t">‹ 返回分类</text>
      </list-item>
    </list>

    <list class="result" if="{{view === 'result'}}" style="height:{{listH}}px">
      <list-item type="r" class="rrow" for="{{viewRows}}" @click="tapRow($item)">
        <text class="rk">{{$item.k}}</text>
        <text class="rv">{{$item.v}}</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import { loadAuth, hasAuth, get, post, go, back, replace, toast } from '../common/api.js'

/**
 * 群管理：分组 → 操作 → 结果 三级。
 * 原则：不让用户记 openid / 策略 ID —— 需要人就点名单，需要规则就点规则。
 */
const GROUPS = [
  {
    key: 'info',
    label: '看看这个群',
    desc: '群资料、机器人权限、本群编号',
    items: [
      { label: '群资料', hint: '群名、人数、简介', action: 'info' },
      { label: '机器人在这里的权限', hint: '是不是管理员、能不能主动发消息', action: 'bot_state' },
      { label: '本群编号（openid）', hint: '不联网，需要填 ID 时用', action: 'local_gid' }
    ]
  },
  {
    key: 'member',
    label: '管群成员',
    desc: '禁言、移出、拉黑',
    items: [
      { label: '选一个成员', hint: '先选人，后面的操作都对他生效', action: 'pick_member' },
      { label: '看成员名单', hint: '群里都有谁', action: 'members' },
      { label: '禁言 10 分钟', hint: '让他暂时不能说话', action: 'op', memberAction: 'mute', seconds: 600, needMember: true },
      { label: '解除禁言', hint: '恢复他说话', action: 'op', memberAction: 'unmute', needMember: true },
      { label: '移出群聊', hint: '踢出群，之后还能再申请', action: 'op', memberAction: 'kick', needMember: true, danger: true },
      { label: '移出并拉黑', hint: '踢出去且以后不能申请', action: 'op', memberAction: 'kick', blacklist: true, needMember: true, danger: true },
      { label: '看黑名单', hint: '被拉黑的人', action: 'blacklist' },
      { label: '加入黑名单', hint: '不踢人，只禁止再进', action: 'op', memberAction: 'blacklist', needMember: true, danger: true },
      { label: '移出黑名单', hint: '恢复他的入群资格', action: 'op', memberAction: 'unblacklist', needMember: true }
    ]
  },
  {
    key: 'join',
    label: '谁要进群',
    desc: '同意或拒绝入群申请',
    items: [
      { label: '看申请列表', hint: '谁在申请进群', action: 'join_requests' },
      { label: '同意一个人进群', hint: '从申请列表里点人', action: 'approve', decision: 'approve', needApplicant: true },
      { label: '拒绝一个人进群', hint: '从申请列表里点人', action: 'approve', decision: 'decline', needApplicant: true }
    ]
  },
  {
    key: 'auto',
    label: '自动放人进群',
    desc: '设规则，不用每次手动批',
    items: [
      { label: '看现有规则', hint: '当前生效的自动审批策略', action: 'strategies' },
      { label: '开启自动同意', hint: '以后申请进群自动通过', action: 'strategy_create' },
      { label: '停用规则', hint: '先选一条规则', action: 'strategy_patch', needStrategy: true, danger: true },
      { label: '删除规则', hint: '先选一条规则', action: 'strategy_delete', needStrategy: true, danger: true }
    ]
  },
  {
    key: 'button',
    label: '发按钮消息',
    desc: '群里发带按钮的消息，点一下就有反馈',
    items: [
      { label: '发投票', hint: '三个选项，谁点了我能看到', action: 'buttons_send', preset: 'vote' },
      { label: '发签到', hint: '一键签到按钮', action: 'buttons_send', preset: 'checkin' },
      { label: '发审批按钮', hint: '同意 / 拒绝两个按钮', action: 'buttons_send', preset: 'approve' }
    ]
  }
]

const BUTTON_PRESETS = {
  vote: {
    text: '投票：选一个吧',
    buttons: [
      { id: 'a', label: '选项 A', data: 'vote:A' },
      { id: 'b', label: '选项 B', data: 'vote:B' },
      { id: 'c', label: '选项 C', data: 'vote:C' }
    ]
  },
  checkin: {
    text: '今日签到',
    buttons: [
      { id: 'in', label: '签到', data: 'checkin:yes' },
      { id: 'late', label: '稍后', data: 'checkin:later' }
    ]
  },
  approve: {
    text: '请审批',
    buttons: [
      { id: 'ok', label: '同意', data: 'approve:yes' },
      { id: 'no', label: '拒绝', data: 'approve:no' }
    ]
  }
}

const FIELD_CN = {
  group_openid: '群编号',
  member_openid: '成员编号',
  member_role: '身份',
  joined_at: '入群时间',
  allow_proactive_msg: '可主动发消息',
  recv_msg_setting: '收消息设置',
  group_name: '群名',
  group_member_num: '群人数',
  group_desc: '群简介',
  strategy_id: '规则编号',
  is_enable: '是否启用',
  expire_at: '到期时间',
  whitelist_user_count: '白名单人数',
  next_cursor: '下一页游标',
  username: '昵称',
  banned_at: '拉黑时间',
  apply_at: '申请时间',
  risk_tips: '风险提示',
  status: '状态'
}

const VALUE_CN = {
  member: '普通成员',
  admin: '管理员',
  owner: '群主',
  all: '全部消息',
  only_mention: '仅 @ 我',
  mention_and_context: '被 @ 及上下文',
  on: '已启用',
  off: '已关闭',
  true: '是',
  false: '否',
  pending: '待处理',
  approved: '已同意',
  rejected: '已拒绝'
}

export default {
  protected: {
    cid: '',
    title0: ''
  },

  private: {
    vh: 480,
    listH: 424,
    title: '群管理',
    subtitle: '选一个分类开始',
    groups: GROUPS,
    items: [],
    view: 'groups',
    viewRows: [],
    busy: false,
    selText: '',
    selMember: null,
    selStrategy: null,
    selApplicant: null,
    pickMode: '',
    pendingItem: null,
    curGroup: null
  },

  onInit() {
    const vh = (typeof global !== 'undefined' && global.designH) || 480
    this.vh = vh
    this.listH = vh - 56
    loadAuth(() => {
      if (!hasAuth()) { replace('Login'); return }
      if (!this.cid) { back(); return }
    })
  },

  openGroup(g) {
    if (!g) return
    this.curGroup = g
    this.items = g.items || []
    this.title = g.label
    this.subtitle = g.desc || ''
    this.view = 'items'
  },

  backOne() {
    if (this.view === 'result') {
      this.view = this.curGroup ? 'items' : 'groups'
      this.title = this.curGroup ? this.curGroup.label : '群管理'
      this.subtitle = this.curGroup ? (this.curGroup.desc || '') : '选一个分类开始'
      this.viewRows = []
      this.pickMode = ''
      return
    }
    if (this.view === 'items') {
      this.view = 'groups'
      this.curGroup = null
      this.title = '群管理'
      this.subtitle = '选一个分类开始'
      return
    }
    back()
  },

  goBack() {
    back()
  },

  setRows(rows) {
    const src = (rows && rows.length) ? rows : [{ k: '结果', v: '没有数据' }]
    const out = []
    for (let i = 0; i < src.length; i++) {
      const r = src[i] || {}
      out.push({
        k: String(r.k || '—'),
        v: String(r.v || '—'),
        clickable: !!r.clickable,
        isBack: !!r.isBack,
        confirmYes: !!r.confirmYes
      })
    }
    out.push({ k: '‹ 返回', v: '点这行回上一页', isBack: true })
    this.viewRows = out
    this.view = 'result'
    this.busy = false
  },

  humanRows(rows) {
    const out = []
    for (let i = 0; i < (rows || []).length; i++) {
      const r = rows[i] || {}
      const key = String(r.k || '')
      const short = key.indexOf('.') >= 0 ? key.slice(key.lastIndexOf('.') + 1) : key
      const label = FIELD_CN[short] || key
      let val = String(r.v == null ? '—' : r.v)
      if (VALUE_CN[val] !== undefined) val = VALUE_CN[val]
      out.push({ k: label, v: val })
    }
    return out
  },

  refreshSel() {
    const parts = []
    if (this.selMember) parts.push('成员：' + (this.selMember.name || this.selMember.openid.slice(0, 8)))
    if (this.selStrategy) parts.push('规则：' + (this.selStrategy.label || this.selStrategy.id.slice(0, 10)))
    if (this.selApplicant) parts.push('申请人：' + (this.selApplicant.name || this.selApplicant.openid.slice(0, 8)))
    this.selText = parts.join('　')
  },

  tapItem(it) {
    if (!it) return
    if (it.action === 'local_gid') { this.localGid(); return }
    if (it.action === 'pick_member') { this.pickMember(); return }
    if (it.action === 'buttons_send') { this.sendButtons(it); return }

    if (it.needMember && !this.selMember) {
      toast('先选一个成员')
      this.pendingItem = it
      this.pickMember()
      return
    }
    if (it.needApplicant && !this.selApplicant) {
      this.pendingItem = it
      this.pickApplicant(it)
      return
    }
    if (it.needStrategy && !this.selStrategy) {
      toast('先选一条规则')
      this.pendingItem = it
      this.pickStrategy()
      return
    }
    if (it.danger) { this.confirm(it); return }
    this.run(it)
  },

  confirm(it) {
    const who = it.needMember && this.selMember
      ? (this.selMember.name || this.selMember.openid.slice(0, 8))
      : (it.needStrategy && this.selStrategy ? (this.selStrategy.label || this.selStrategy.id) : '')
    this.pendingItem = it
    this.setRows([
      { k: '要执行', v: it.label },
      { k: '对象', v: who || '—' },
      { k: '确认执行', v: '点这行继续', confirmYes: true },
      { k: '取消', v: '点这行返回', isBack: true }
    ])
  },

  localGid() {
    const cid = String(this.cid || '')
    const i = cid.indexOf(':')
    const gid = i > 0 ? cid.slice(i + 1) : cid
    this.setRows([
      { k: '群编号', v: gid },
      { k: '说明', v: '需要填群 ID 时用这一串' }
    ])
  },

  pickMember() {
    if (this.busy) return
    this.busy = true
    get('/api/watch/members', { conversationId: this.cid }, (err, obj) => {
      if (err) {
        this.setRows([
          { k: '读不到成员', v: String(err.msg || '无法读取') },
          { k: '原因', v: '官方成员接口需要白名单' },
          { k: '替代', v: '先在群里发条消息，让我记住成员' }
        ])
        return
      }
      const list = (obj && obj.members) || []
      if (!list.length) {
        this.setRows([{ k: '没有成员', v: '先在群里发条消息' }])
        return
      }
      const out = []
      for (let i = 0; i < list.length; i++) {
        const m = list[i] || {}
        const oid = String(m.openid || m.memberOpenid || '')
        if (!oid) continue
        out.push({ k: String(m.name || '成员').slice(0, 8), v: '点这行选中', clickable: true, oid: oid, nm: String(m.name || '') })
      }
      if (!out.length) {
        this.setRows([{ k: '没有可选成员', v: '成员数据里没有编号' }])
        return
      }
      this.pickMode = 'member'
      this.viewRows = out
      this.viewRows.push({ k: '‹ 返回', v: '点这行回上一页', isBack: true })
      this.view = 'result'
      this.busy = false
      this.title = '选成员'
      this.subtitle = '点一个人，后面的操作都用他'
    })
  },

  pickStrategy() {
    if (this.busy) return
    this.busy = true
    post('/api/watch/group/api', { action: 'strategies', conversationId: this.cid, tt: 0 }, (err, obj) => {
      if (err) { this.setRows([{ k: '读取失败', v: String(err.msg || '失败') }]); return }
      const raw = (obj && obj.raw) || {}
      const list = raw.strategies || []
      if (!list.length) {
        this.setRows([{ k: '还没有规则', v: '先点「开启自动同意」创建一条' }])
        return
      }
      this.pickMode = 'strategy'
      this.viewRows = []
      for (let i = 0; i < list.length; i++) {
        const st = list[i] || {}
        const id = String(st.strategy_id || '')
        const label = String(st.remark || id.slice(0, 12))
        this.viewRows.push({
          k: label.slice(0, 8),
          v: (st.is_enable === 'on' ? '启用中' : '已停用') + ' · 点这行选中',
          clickable: true,
          sid: id,
          slabel: label
        })
      }
      this.viewRows.push({ k: '‹ 返回', v: '点这行回上一页', isBack: true })
      this.view = 'result'
      this.busy = false
      this.title = '选规则'
      this.subtitle = '点一条规则'
    })
  },

  pickApplicant(it) {
    if (this.busy) return
    this.busy = true
    post('/api/watch/group/api', { action: 'join_requests', conversationId: this.cid, tt: 0 }, (err, obj) => {
      if (err) { this.setRows([{ k: '读取失败', v: String(err.msg || '失败') }]); return }
      const raw = (obj && obj.raw) || {}
      const list = raw.requests || raw.join_requests || raw.list || []
      if (!list.length) {
        this.setRows([{ k: '没有待审批', v: '现在没人申请进群' }])
        return
      }
      this.pickMode = 'applicant'
      this.pendingItem = it
      this.viewRows = []
      for (let i = 0; i < list.length; i++) {
        const r = list[i] || {}
        const oid = String(r.member_openid || '')
        if (!oid) continue
        this.viewRows.push({
          k: String(r.username || '申请人').slice(0, 8),
          v: '点这行选他',
          clickable: true,
          oid: oid,
          nm: String(r.username || '')
        })
      }
      if (!this.viewRows.length) {
        this.setRows([{ k: '没有可选申请人', v: '申请数据里没有成员编号' }])
        return
      }
      this.viewRows.push({ k: '‹ 返回', v: '点这行回上一页', isBack: true })
      this.view = 'result'
      this.busy = false
      this.title = '选申请人'
      this.subtitle = '点一个人'
    })
  },

  tapRow(item) {
    if (!item) return
    if (item.isBack) { this.backOne(); return }
    if (item.confirmYes) {
      const it = this.pendingItem
      this.pendingItem = null
      if (it) this.run(it)
      return
    }
    if (this.pickMode === 'member') {
      this.selMember = { openid: item.oid, name: item.nm }
      this.finishPick(item.nm || '成员')
      return
    }
    if (this.pickMode === 'strategy') {
      this.selStrategy = { id: item.sid, label: item.slabel }
      this.finishPick('规则')
      return
    }
    if (this.pickMode === 'applicant') {
      this.selApplicant = { openid: item.oid, name: item.nm }
      this.finishPick(item.nm || '申请人')
      return
    }
  },

  finishPick(name) {
    this.pickMode = ''
    this.refreshSel()
    this.view = 'items'
    this.title = this.curGroup ? this.curGroup.label : '群管理'
    this.subtitle = this.curGroup ? (this.curGroup.desc || '') : ''
    this.viewRows = []
    const it = this.pendingItem
    this.pendingItem = null
    toast('已选：' + name)
    if (it) this.run(it)
  },

  sendButtons(it) {
    if (this.busy) return
    const p = BUTTON_PRESETS[it.preset] || BUTTON_PRESETS.vote
    this.busy = true
    post('/api/watch/buttons/send', {
      conversationId: this.cid,
      text: p.text,
      buttons: p.buttons,
      tt: 0
    }, (err) => {
      if (err) { this.setRows([{ k: '发送失败', v: String(err.msg || '失败') }]); return }
      this.setRows([
        { k: '已发出', v: p.text },
        { k: '怎么看结果', v: 'QQ 里有人点按钮，聊天里会出现提示' }
      ])
    })
  },

  run(it) {
    if (this.busy) return
    this.busy = true
    const payload = {
      action: it.action,
      conversationId: this.cid,
      tt: 0
    }
    if (it.memberAction) {
      payload.memberAction = it.memberAction
      payload.memberOpenid = this.selMember ? this.selMember.openid : ''
      payload.seconds = it.seconds || 0
      payload.blacklist = !!it.blacklist
    }
    if (it.action === 'approve') {
      payload.memberOpenid = this.selApplicant ? this.selApplicant.openid : ''
      payload.decision = it.decision || 'approve'
    }
    if (String(it.action).indexOf('strategy_') === 0 && it.action !== 'strategy_create') {
      payload.strategyId = this.selStrategy ? this.selStrategy.id : ''
      if (it.action === 'strategy_patch') payload.patch = { is_enable: 'off' }
    }
    post('/api/watch/group/api', payload, (err, obj) => {
      if (err) {
        const msg = String(err.msg || '操作失败')
        const rows = [{ k: '没成功', v: msg.slice(0, 40) }]
        if (msg.indexOf('11253') >= 0 || msg.indexOf('白名单') >= 0) {
          rows.push({ k: '原因', v: '这个接口要向 QQ 平台申请白名单' })
          rows.push({ k: '怎么申请', v: '邮箱 qq_open@tencent.com' })
          rows.push({ k: '现在能用', v: '禁言、按钮消息、看群编号' })
        } else if (msg.indexOf('管理员') >= 0) {
          rows.push({ k: '原因', v: '机器人不是群管理员' })
          rows.push({ k: '怎么办', v: '在 QQ 群里把机器人设为管理员' })
        }
        this.setRows(rows)
        return
      }
      const rows = this.humanRows((obj && obj.rows) || [])
      if (!rows.length) rows.push({ k: '完成', v: '操作已执行' })
      this.setRows(rows)
    })
  }
}
</script>

<style>
.page { width: 336px; height: 480px; background-color: #000000; flex-direction: column; }
.head { width: 336px; height: 56px; flex-direction: row; align-items: center; padding-left: 12px; padding-right: 12px; border-bottom-width: 1px; border-bottom-color: #333333; }
.h-back { width: 40px; font-size: 32px; color: #3184d0; }
.h-mid { flex-grow: 1; flex-direction: column; justify-content: center; }
.h-title { font-size: 21px; color: #ffffff; font-weight: bold; }
.h-ver { font-size: 11px; color: #5f7185; }
.h-right { width: 44px; font-size: 15px; color: #7f8b99; text-align: right; }
.selbar { width: 336px; height: 32px; padding-left: 12px; padding-right: 12px; background-color: #14202c; justify-content: center; }
.sel-t { font-size: 13px; color: #7fb2e5; lines: 1; text-overflow: ellipsis; }
.tip { width: 336px; height: 60px; align-items: center; justify-content: center; }
.tip-t { font-size: 18px; color: #8fa3bd; }
.menu { width: 336px; }
.result { width: 336px; }
.cell { width: 336px; height: 62px; flex-direction: column; justify-content: center; padding-left: 14px; padding-right: 14px; border-bottom-width: 1px; border-bottom-color: #222222; }
.cell-t { font-size: 18px; color: #e8e8e8; }
.cell-s { font-size: 13px; color: #7a8797; }
.rrow { width: 336px; height: 48px; flex-direction: row; align-items: center; padding-left: 12px; padding-right: 12px; border-bottom-width: 1px; border-bottom-color: #1c1c1c; }
.rk { width: 120px; font-size: 13px; color: #8fa3bd; lines: 1; text-overflow: ellipsis; }
.rv { flex-grow: 1; font-size: 13px; color: #d8e2ee; lines: 2; text-overflow: ellipsis; }
</style>
