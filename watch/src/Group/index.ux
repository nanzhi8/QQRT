.h-back { width: 40px; font-size: 32px; color: #3184d0; }
.h-mid { flex-grow: 1; flex-direction: column; justify-content: center; }
.h-title { font-size: 21px; color: #ffffff; font-weight: bold; }
.h-ver { font-size: 11px; color: #5f7185; }
.h-right { width: 44px; font-size: 15px; color: #7f8b99; text-align: right; }
.selbar { width: 336px; height: 32px; padding-left: 12px; padding-right: 12px; background-color: #14202c; justify-content: center; }
.sel-t { font-size: 13px; color: #7fb2e5; lines: 1; text-overflow: ellipsis; }
