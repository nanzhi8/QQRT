<template>
  <div class="page" style="height:{{vh}}px">
    <div class="head">
      <text class="h-back" @click="goBack">‹</text>
      <div class="h-mid">
        <text class="h-title">群管理</text>
        <text class="h-ver">v4.11.2 · b1129</text>
      </div>
      <text class="h-right" @click="editArg">参数</text>
    </div>

    <div class="arg" if="{{argText}}">
      <text class="arg-t">{{argLabel}}：{{argText}}</text>
    </div>

    <div class="tip" if="{{busy}}">
      <text class="tip-t">请求中…</text>
    </div>

    <list class="menu" if="{{showMenu}}" style="height:{{listH}}px">
      <list-item type="m" class="cell" for="{{menu}}" @click="exec($item)">
        <text class="cell-t">{{$item.label}}</text>
        <text class="cell-s">{{$item.desc}}</text>
      </list-item>
    </list>

    <list class="result" if="{{showResult}}" style="height:{{listH}}px">
      <list-item type="r" class="rrow" for="{{viewRows}}" @click="tapRow($item)" @longpress="useAsArg($item)">
        <text class="rk">{{$item.k}}</text>
        <text class="rv">{{$item.v}}</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import { loadAuth, hasAuth, get, post, go, back, replace, toast } from '../common/api.js'

const MENU = [
  { label: '本群 ID（openid）', desc: '本地解析，无需联网', action: 'local_gid' },
  { label: '选择成员取 openid', desc: '点一个人自动填入参数', action: 'pick_member' },
  { label: '群资料', desc: '群名 / 简介 / 人数', action: 'info' },
  { label: '机器人群内状态', desc: '角色 / 接收消息设置', action: 'bot_state' },
  { label: '群成员列表', desc: '含角色、入群时间', action: 'members' },
  { label: '查询成员详情', desc: '需填成员 openid', action: 'member', arg: '成员 openid' },
  { label: '禁言状态', desc: '全员规则 + 禁言名单', action: 'mute_state' },
  { label: '群黑名单', desc: '被拉黑成员列表', action: 'blacklist' },
  { label: '入群申请列表', desc: '待审批的申请', action: 'join_requests' },
  { label: '同意入群申请', desc: '需填申请人 openid', action: 'approve', decision: 'approve', arg: '申请人 openid' },
  { label: '拒绝入群申请', desc: '需填申请人 openid', action: 'approve', decision: 'decline', arg: '申请人 openid' },
  { label: '禁言 10 分钟', desc: '需填成员 openid', action: 'op', memberAction: 'mute', seconds: 600, arg: '成员 openid' },
  { label: '解除禁言', desc: '需填成员 openid', action: 'op', memberAction: 'unmute', arg: '成员 openid' },
  { label: '移出群聊', desc: '需填成员 openid', action: 'op', memberAction: 'kick', arg: '成员 openid' },
  { label: '移出并拉黑', desc: '需填成员 openid', action: 'op', memberAction: 'kick', blacklist: true, arg: '成员 openid' },
  { label: '加入黑名单', desc: '需填成员 openid', action: 'op', memberAction: 'blacklist', arg: '成员 openid' },
  { label: '移出黑名单', desc: '需填成员 openid', action: 'op', memberAction: 'unblacklist', arg: '成员 openid' },
  { label: '自动审批策略列表', desc: '查询生效中的策略', action: 'strategies' },
  { label: '开启自动审批', desc: '为本群创建策略', action: 'strategy_create' },
  { label: '停用自动审批', desc: '需填策略 ID', action: 'strategy_patch', arg: '策略 ID' },
  { label: '删除自动审批策略', desc: '需填策略 ID', action: 'strategy_delete', arg: '策略 ID' },
  { label: '执行自动审批策略', desc: '需填策略 ID', action: 'strategy_execute', arg: '策略 ID' },
  { label: '添加白名单 QQ 号', desc: '需填策略 ID 与 QQ 号', action: 'strategy_whitelist', arg: '策略 ID,QQ号', qq: true },
  { label: '发起投票', desc: '发出带 3 个选项的按钮消息', action: 'buttons_send', preset: 'vote' },
  { label: '发起签到', desc: '发出一键签到按钮', action: 'buttons_send', preset: 'checkin' },
  { label: '发起审批', desc: '发出同意 / 拒绝按钮', action: 'buttons_send', preset: 'approve' }
]

const BUTTON_PRESETS = {
  vote: {
    text: '投票：选一个吧',
    buttons: [
      { id: 'a', label: '选项 A', data: 'vote:A' },
      { id: 'b', label: '选项 B', data: 'vote:B' },
      { id: 'c', label: '选项 C', data: 'vote:C' }
    ]
  },
  checkin: {
    text: '今日签到',
    buttons: [
      { id: 'in', label: '签到', data: 'checkin:yes' },
      { id: 'late', label: '稍后', data: 'checkin:later' }
    ]
  },
  approve: {
    text: '请审批',
    buttons: [
      { id: 'ok', label: '同意', data: 'approve:yes' },
      { id: 'no', label: '拒绝', data: 'approve:no' }
    ]
  }
}

export default {
  protected: {
    cid: '',
    title: ''
  },

  private: {
    vh: 480,
    listH: 424,
    menu: MENU,
    viewRows: [],
    showMenu: true,
    showResult: false,
    busy: false,
    argText: '',
    argLabel: '',
    pending: null,
    picking: false
  },

  onInit() {
    const vh = (typeof global !== 'undefined' && global.designH) || 480
    this.vh = vh
    this.listH = vh - 56
    loadAuth(() => {
      if (!hasAuth()) { replace('Login'); return }
      if (!this.cid) { back(); return }
    })
  },

  onShow() {
    const r = typeof global !== 'undefined' ? global.__imeResult : null
    if (!r) return
    global.__imeResult = null
    if (!r.confirmed) return
    const v = String(r.text || '').trim()
    if (!v) return
    this.argText = v
    if (this.pending) {
      const m = this.pending
      this.pending = null
      this.run(m)
    }
  },

  editArg() {
    if (typeof global !== 'undefined') {
      global.__imeText = this.argText || ''
      global.__imeLabel = '参数'
      global.__imeResult = null
    }
    go('Ime')
  },

  /**
   * 所有行（含「返回菜单」）统一放进一个数组、统一 type="r"、统一固定高度。
   * Vela 的 list 混用 for 生成的 list-item 和静态 list-item 时，会只渲染静态项，
   * 这正是「页面只剩返回菜单」的原因。
   */
  setRows(rows) {
    const src = (rows && rows.length) ? rows : [{ k: '结果', v: '无数据' }]
    const out = []
    for (let i = 0; i < src.length; i++) {
      const r = src[i] || {}
      out.push({
        k: String(r.k || '—'),
        v: String(r.v || '—'),
        clickable: !!r.clickable,
        isBack: false
      })
    }
    out.push({ k: '‹ 返回菜单', v: '点这行回菜单', clickable: false, isBack: true })
    this.viewRows = out
    this.showMenu = false
    this.showResult = true
    this.busy = false
  },

  backToMenu() {
    this.viewRows = []
    this.showResult = false
    this.showMenu = true
    this.busy = false
    this.picking = false
    this.argText = ''
  },

  localGid() {
    const cid = String(this.cid || '')
    const i = cid.indexOf(':')
    const gid = i > 0 ? cid.slice(i + 1) : cid
    this.setRows([
      { k: '会话 ID', v: cid },
      { k: '群 openid', v: gid },
      { k: '提示', v: '长按任意一行可把值填进参数' },
      { k: '机器人 ID', v: '点「机器人群内状态」看 member_openid' }
    ])
  },

  pickMember() {
    if (this.busy) return
    this.busy = true
    get('/api/watch/members', { conversationId: this.cid }, (err, obj) => {
      if (err) {
        this.setRows([{ k: '错误', v: String(err.msg || '读取成员失败') }])
        return
      }
      const list = (obj && obj.members) || []
      if (!list.length) {
        this.setRows([{ k: '提示', v: '暂无成员，先在群里发一条消息再试' }])
        return
      }
      const out = []
      for (let i = 0; i < list.length; i++) {
        const m = list[i] || {}
        const oid = String(m.openid || m.memberOpenid || '')
        if (!oid) continue
        out.push({ k: String(m.name || '成员').slice(0, 8), v: oid, clickable: true })
      }
      this.picking = true
      this.setRows(out.length ? out : [{ k: '提示', v: '成员数据里没有 openid' }])
    })
  },

  tapRow(item) {
    if (!item) return
    if (item.isBack) { this.backToMenu(); return }
    if (item.clickable) this.useAsArg(item)
  },

  useAsArg(item) {
    if (!item) return
    if (item.isBack) { this.backToMenu(); return }
    const v = String(item.v || item.k || '').trim()
    if (!v || v === '—') return
    this.backToMenu()
    this.argText = v
    this.argLabel = '参数'
    toast('已填入参数：' + v.slice(0, 12))
  },

  sendButtons(m) {
    if (this.busy) return
    const p = BUTTON_PRESETS[m.preset] || BUTTON_PRESETS.vote
    this.busy = true
    post('/api/watch/buttons/send', {
      conversationId: this.cid,
      text: p.text,
      buttons: p.buttons,
      tt: 0
    }, (err) => {
      if (err) { this.setRows([{ k: '错误', v: String(err.msg || '发送失败') }]); return }
      this.setRows([{ k: '按钮消息', v: '已发送，QQ 端点按钮后聊天里会出提示' }])
      toast('按钮消息已发出')
    })
  },

  exec(m) {
    if (!m) return
    if (m.action === 'local_gid') { this.localGid(); return }
    if (m.action === 'pick_member') { this.pickMember(); return }
    if (m.action === 'buttons_send') { this.sendButtons(m); return }
    if (m.arg && !this.argText) {
      this.pending = m
      this.argLabel = m.arg
      this.editArg()
      return
    }
    this.run(m)
  },

  run(m) {
    if (this.busy) return
    this.busy = true
    this.showMenu = false
    this.showResult = false
    const payload = {
      action: m.action,
      conversationId: this.cid,
      memberOpenid: this.argText,
      seconds: m.seconds || 0,
      blacklist: !!m.blacklist,
      decision: m.decision || 'approve',
      memberAction: m.memberAction || '',
      tt: 0
    }
    if (String(m.action).indexOf('strategy_') === 0 && m.action !== 'strategies' && m.action !== 'strategy_create') {
      const parts = String(this.argText || '').split(',')
      payload.strategyId = (parts[0] || '').trim()
      if (m.qq) payload.qqs = (parts[1] || '').trim() ? [(parts[1] || '').trim()] : []
      if (m.action === 'strategy_patch') payload.patch = { is_enable: 'off' }
      payload.op = 'add'
    }
    post('/api/watch/group/api', payload, (err, obj) => {
      if (err) {
        if (err.code === 'AUTH') { replace('Login'); return }
        this.setRows([{ k: '错误', v: String(err.msg || '请求失败').slice(0, 40) }])
        toast(err.msg || '请求失败')
        return
      }
      this.setRows((obj && obj.rows) || [{ k: '结果', v: '成功' }])
      if (m.action === 'strategy_create' || m.action === 'strategy_patch' || m.action === 'strategy_delete') {
        toast('操作成功')
      }
    })
  },

  goBack() {
    back()
  }
}
</script>

<style>
.page { width: 336px; height: 480px; background-color: #000000; flex-direction: column; }
.head { width: 336px; height: 56px; flex-direction: row; align-items: center; padding-left: 12px; padding-right: 12px; border-bottom-width: 1px; border-bottom-color: #333333; }
.h-back { width: 40px; font-size: 32px; color: #3184d0; }
.h-mid { flex-grow: 1; flex-direction: column; justify-content: center; }
.h-title { font-size: 23px; color: #ffffff; font-weight: bold; }
.h-ver { font-size: 11px; color: #5f7185; }
.h-right { width: 56px; font-size: 17px; color: #3184d0; text-align: right; }
.arg { width: 336px; height: 34px; padding-left: 12px; padding-right: 12px; background-color: #14202c; justify-content: center; }
.arg-t { font-size: 14px; color: #7fb2e5; lines: 1; text-overflow: ellipsis; }
.tip { width: 336px; height: 60px; align-items: center; justify-content: center; }
.tip-t { font-size: 18px; color: #8fa3bd; }
.menu { width: 336px; }
.result { width: 336px; }
.cell { width: 336px; height: 60px; flex-direction: column; justify-content: center; padding-left: 14px; padding-right: 14px; border-bottom-width: 1px; border-bottom-color: #222222; }
.cell-t { font-size: 18px; color: #e8e8e8; }
.cell-s { font-size: 13px; color: #7a8797; }
.rrow { width: 336px; height: 46px; flex-direction: row; align-items: center; padding-left: 12px; padding-right: 12px; border-bottom-width: 1px; border-bottom-color: #1c1c1c; }
.rk { width: 130px; font-size: 13px; color: #8fa3bd; lines: 1; text-overflow: ellipsis; }
.rv { flex-grow: 1; font-size: 13px; color: #d8e2ee; lines: 2; text-overflow: ellipsis; }
</style>
