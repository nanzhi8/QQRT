<template>
  <div class="page" style="height:{{vh}}px">
    <div class="head">
      <text class="h-back" @click="backOne">‹</text>
      <div class="h-mid">
        <text class="h-title">{{title}}</text>
        <text class="h-ver">{{subtitle}}</text>
      </div>
      <text class="h-right" @click="goBack">退出</text>
    </div>

    <div class="selbar" if="{{selText}}">
      <text class="sel-t">{{selText}}</text>
    </div>

    <div class="tip" if="{{busy}}">
      <text class="tip-t">正在处理…</text>
    </div>

    <list class="menu" if="{{view === 'groups'}}" style="height:{{listH}}px">
      <list-item type="g" class="cell" for="{{groups}}" @click="openGroup($item)">
        <text class="cell-t">{{$item.label}}</text>
        <text class="cell-s">{{$item.desc}}</text>
      </list-item>
      <list-item type="g2" class="cell" @click="goBack">
        <text class="cell-t">‹ 回到聊天</text>
        <text class="cell-s">这里只改这个群</text>
      </list-item>
    </list>

    <list class="menu" if="{{view === 'items'}}" style="height:{{listH}}px">
      <list-item type="i" class="cell" for="{{items}}" @click="tapItem($item)">
        <text class="cell-t">{{$item.label}}</text>
        <text class="cell-s">{{$item.hint}}</text>
      </list-item>
      <list-item type="i2" class="cell" @click="backOne">
        <text class="cell-t">‹ 回去</text>
      </list-item>
    </list>

    <list class="result" if="{{view === 'result'}}" style="height:{{listH}}px">
      <list-item type="r" class="rrow" for="{{viewRows}}" @click="tapRow($item)">
        <text class="rk">{{$item.k}}</text>
        <text class="rv">{{$item.v}}</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import { loadAuth, hasAuth, get, post, go, back, replace, toast } from '../common/api.js'

/**
 * 群管理：全部用口语写，不出现 openid / 策略 / 接口 等词。
 * 首屏只有 4 件事，点进去再选具体动作。
 */
const GROUPS = [
  {
    key: 'member',
    label: '让某个人安静',
    desc: '禁言、踢出群、不许他再进',
    items: [
      { label: '先点一个人', hint: '从群名单里点，后面都对他生效', action: 'pick_member' },
      { label: '让他 10 分钟不能说话', hint: '时间到了自动恢复', action: 'op', memberAction: 'mute', seconds: 600, needMember: true, done: '他 10 分钟内不能说话了' },
      { label: '让他重新能说话', hint: '提前解除禁言', action: 'op', memberAction: 'unmute', needMember: true, done: '他恢复说话了' },
      { label: '把他踢出群', hint: '踢出去，以后还能再申请', action: 'op', memberAction: 'kick', needMember: true, danger: true, done: '已把他踢出群' },
      { label: '踢出去，不许再进', hint: '踢人 + 拉黑，最狠的一档', action: 'op', memberAction: 'kick', blacklist: true, needMember: true, danger: true, done: '已踢出并禁止他再进群' },
      { label: '看谁被拉黑了', hint: '被禁止进群的人', action: 'blacklist' },
      { label: '不许他再进群', hint: '不踢人，只是挡住以后', action: 'op', memberAction: 'blacklist', needMember: true, danger: true, done: '已禁止他再进群' },
      { label: '允许他重新进群', hint: '把他从黑名单里放出来', action: 'op', memberAction: 'unblacklist', needMember: true, done: '已允许他重新进群' }
    ]
  },
  {
    key: 'info',
    label: '看看这个群',
    desc: '群名、人数、我说话算不算数',
    items: [
      { label: '群名和人数', hint: '这个群叫什么、有多少人', action: 'info' },
      { label: '我说话算不算数', hint: '我是不是管理员、能不能主动发消息', action: 'bot_state' },
      { label: '这个群的编号', hint: '别人找你要群 ID 时给他这个', action: 'local_gid' }
    ]
  },
  {
    key: 'notify',
    label: '发个通知到群里',
    desc: '带按钮的消息，点一下就有反馈',
    items: [
      { label: '发个投票', hint: '三个选项，谁点了我能看到', action: 'buttons_send', preset: 'vote', done: '投票已发到群里' },
      { label: '发个签到', hint: '群里会出现「签到」按钮', action: 'buttons_send', preset: 'checkin', done: '签到已发到群里' },
      { label: '发个同意/拒绝', hint: '两个按钮，适合征求意见', action: 'buttons_send', preset: 'approve', done: '审批按钮已发到群里' }
    ]
  },
  {
    key: 'join',
    label: '处理进群申请',
    desc: '谁要进来，同意还是拒绝',
    items: [
      { label: '谁在申请进群', hint: '看看有哪些人想进来', action: 'join_requests' },
      { label: '同意一个人进来', hint: '从申请名单里点他', action: 'approve', decision: 'approve', needApplicant: true, done: '已同意他进群' },
      { label: '拒绝一个人', hint: '从申请名单里点他', action: 'approve', decision: 'decline', needApplicant: true, danger: true, done: '已拒绝他的申请' },
      { label: '以后自动同意', hint: '设好规则，不用每次手动点', action: 'strategy_create', done: '已开启自动同意进群' },
      { label: '看现有的自动规则', hint: '当前生效的规则', action: 'strategies' },
      { label: '关掉自动同意', hint: '先选一条规则', action: 'strategy_patch', needStrategy: true, danger: true, done: '规则已停用' },
      { label: '删掉一条规则', hint: '先选一条规则', action: 'strategy_delete', needStrategy: true, danger: true, done: '规则已删除' }
    ]
  }
]

const BUTTON_PRESETS = {
  vote: {
    text: '投票：选一个吧',
    buttons: [
      { id: 'a', label: '选项 A', data: 'vote:A' },
      { id: 'b', label: '选项 B', data: 'vote:B' },
      { id: 'c', label: '选项 C', data: 'vote:C' }
    ]
  },
  checkin: {
    text: '今日签到',
    buttons: [
      { id: 'in', label: '签到', data: 'checkin:yes' },
      { id: 'late', label: '稍后', data: 'checkin:later' }
    ]
  },
  approve: {
    text: '请审批',
    buttons: [
      { id: 'ok', label: '同意', data: 'approve:yes' },
      { id: 'no', label: '拒绝', data: 'approve:no' }
    ]
  }
}

/** 服务端字段 → 大白话 */
const FIELD_CN = {
  group_openid: '群编号',
  member_openid: '成员',
  member_role: '身份',
  joined_at: '什么时候进群的',
  allow_proactive_msg: '能不能主动发消息',
  recv_msg_setting: '收消息方式',
  group_name: '群名',
  group_member_num: '人数',
  group_desc: '群介绍',
  strategy_id: '规则',
  is_enable: '状态',
  expire_at: '什么时候失效',
  whitelist_user_count: '白名单人数',
  next_cursor: '还有下一页',
  username: '名字',
  banned_at: '什么时候拉黑的',
  apply_at: '什么时候申请的',
  risk_tips: '风险提示',
  status: '状态'
}

const VALUE_CN = {
  member: '普通成员（说话不算数）',
  admin: '管理员（能管事）',
  owner: '群主',
  all: '所有消息都收',
  only_mention: '只有 @ 我才收',
  mention_and_context: '被 @ 时收',
  on: '开着',
  off: '关着',
  true: '能',
  false: '不能',
  pending: '还没处理',
  approved: '已同意',
  rejected: '已拒绝'
}

export default {
  protected: {
    cid: '',
    title0: ''
  },

  private: {
    vh: 480,
    listH: 424,
    title: '群管理',
    subtitle: '点下面的事，我帮你做',
    groups: GROUPS,
    items: [],
    view: 'groups',
    viewRows: [],
    busy: false,
    selText: '',
    selMember: null,
    selStrategy: null,
    selApplicant: null,
    pickMode: '',
    pendingItem: null,
    curGroup: null
  },

  onInit() {
    const vh = (typeof global !== 'undefined' && global.designH) || 480
    this.vh = vh
    this.listH = vh - 56
    loadAuth(() => {
      if (!hasAuth()) { replace('Login'); return }
      if (!this.cid) { back(); return }
    })
  },

  openGroup(g) {
    if (!g) return
    this.curGroup = g
    this.items = g.items || []
    this.title = g.label
    this.subtitle = g.desc || ''
    this.view = 'items'
  },

  backOne() {
    if (this.view === 'result') {
      this.view = this.curGroup ? 'items' : 'groups'
      this.title = this.curGroup ? this.curGroup.label : '群管理'
      this.subtitle = this.curGroup ? (this.curGroup.desc || '') : '点下面的事，我帮你做'
      this.viewRows = []
      this.pickMode = ''
      return
    }
    if (this.view === 'items') {
      this.view = 'groups'
      this.curGroup = null
      this.title = '群管理'
      this.subtitle = '点下面的事，我帮你做'
      return
    }
    back()
  },

  goBack() {
    back()
  },

  setRows(rows) {
    const src = (rows && rows.length) ? rows : [{ k: '好了', v: '已经做完' }]
    const out = []
    for (let i = 0; i < src.length; i++) {
      const r = src[i] || {}
      out.push({
        k: String(r.k || '—'),
        v: String(r.v || '—'),
        clickable: !!r.clickable,
        isBack: !!r.isBack,
        confirmYes: !!r.confirmYes
      })
    }
    out.push({ k: '‹ 回去', v: '点这行回上一页', isBack: true })
    this.viewRows = out
    this.view = 'result'
    this.busy = false
  },

  humanRows(rows) {
    const out = []
    for (let i = 0; i < (rows || []).length; i++) {
      const r = rows[i] || {}
      const key = String(r.k || '')
      const short = key.indexOf('.') >= 0 ? key.slice(key.lastIndexOf('.') + 1) : key
      const label = FIELD_CN[short] || key
      let val = String(r.v == null ? '—' : r.v)
      if (VALUE_CN[val] !== undefined) val = VALUE_CN[val]
      out.push({ k: label, v: val })
    }
    return out
  },

  refreshSel() {
    const parts = []
    if (this.selMember) parts.push('选中：' + (this.selMember.name || '这位成员'))
    if (this.selStrategy) parts.push('规则：' + (this.selStrategy.label || '已选'))
    if (this.selApplicant) parts.push('申请人：' + (this.selApplicant.name || '这位'))
    this.selText = parts.join('　')
  },

  tapItem(it) {
    if (!it) return
    if (it.action === 'local_gid') { this.localGid(); return }
    if (it.action === 'pick_member') { this.pickMember(); return }
    if (it.action === 'buttons_send') { this.sendButtons(it); return }

    if (it.needMember && !this.selMember) {
      toast('先点一个人')
      this.pendingItem = it
      this.pickMember()
      return
    }
    if (it.needApplicant && !this.selApplicant) {
      this.pendingItem = it
      this.pickApplicant(it)
      return
    }
    if (it.needStrategy && !this.selStrategy) {
      toast('先选一条规则')
      this.pendingItem = it
      this.pickStrategy()
      return
    }
    if (it.danger) { this.confirm(it); return }
    this.run(it)
  },

  confirm(it) {
    const who = it.needMember && this.selMember
      ? (this.selMember.name || '这位成员')
      : (it.needStrategy && this.selStrategy ? (this.selStrategy.label || '这条规则') : '')
    this.pendingItem = it
    this.setRows([
      { k: '要做什么', v: it.label },
      { k: '对谁', v: who || '—' },
      { k: '确定，就这么办', v: '点这行执行', confirmYes: true },
      { k: '算了，不做了', v: '点这行返回', isBack: true }
    ])
  },

  localGid() {
    const cid = String(this.cid || '')
    const i = cid.indexOf(':')
    const gid = i > 0 ? cid.slice(i + 1) : cid
    this.setRows([
      { k: '这个群的编号', v: gid },
      { k: '什么时候用', v: '别人要你填「群 ID」时，给他这一串' }
    ])
  },

  pickMember() {
    if (this.busy) return
    this.busy = true
    // 先问服务端「最近在群里说过话的人」——纯本地数据，不需要白名单权限。
    post('/api/watch/group/api', { action: 'recent_senders', conversationId: this.cid, tt: 0 }, (err, obj) => {
      const recent = (!err && obj && obj.members) ? obj.members : []
      if (recent.length) { this.showMemberList(recent, '最近在群里说过话的人'); return }
      this.pickMemberOfficial()
    })
  },

  pickMemberOfficial() {
    get('/api/watch/members', { conversationId: this.cid }, (err, obj) => {
      if (err) {
        this.setRows([
          { k: '选不了人', v: '群里还没人说过话，我也拿不到名单' },
          { k: '怎么办', v: '让想处理的人在群里发句话，再回来点' },
          { k: '另一条路', v: '去 QQ 开放平台申请成员权限' }
        ])
        return
      }
      const list = (obj && obj.members) || []
      if (!list.length) {
        this.setRows([{ k: '名单是空的', v: '先让群里有人说句话' }])
        return
      }
      this.showMemberList(list, '群成员')
    })
  },

  showMemberList(list, sub) {
    const out = []
    for (let i = 0; i < list.length; i++) {
      const m = list[i] || {}
      const oid = String(m.openid || m.memberOpenid || '')
      if (!oid) continue
      out.push({ k: String(m.name || '没名字的成员').slice(0, 8), v: '点这行选他', clickable: true, oid: oid, nm: String(m.name || '') })
    }
    if (!out.length) {
      this.setRows([{ k: '没有可选的人', v: '名单里没有可用的成员' }])
      return
    }
    this.pickMode = 'member'
    this.viewRows = out
    this.viewRows.push({ k: '‹ 回去', v: '点这行回上一页', isBack: true })
    this.view = 'result'
    this.busy = false
    this.title = '选一个人'
    this.subtitle = sub || '点谁，后面的操作就对他'
  },

  pickStrategy() {
    if (this.busy) return
    this.busy = true
    post('/api/watch/group/api', { action: 'strategies', conversationId: this.cid, tt: 0 }, (err, obj) => {
      if (err) { this.setRows([{ k: '没读到规则', v: String(err.msg || '读取失败') }]); return }
      const raw = (obj && obj.raw) || {}
      const list = raw.strategies || []
      if (!list.length) {
        this.setRows([{ k: '还没有自动规则', v: '先点「以后自动同意」建一条' }])
        return
      }
      this.pickMode = 'strategy'
      this.viewRows = []
      for (let i = 0; i < list.length; i++) {
        const st = list[i] || {}
        const id = String(st.strategy_id || '')
        const label = String(st.remark || '规则 ' + (i + 1))
        this.viewRows.push({
          k: label.slice(0, 8),
          v: (st.is_enable === 'on' ? '正在用' : '已停用') + ' · 点这行选它',
          clickable: true,
          sid: id,
          slabel: label
        })
      }
      this.viewRows.push({ k: '‹ 回去', v: '点这行回上一页', isBack: true })
      this.view = 'result'
      this.busy = false
      this.title = '选一条规则'
      this.subtitle = '点哪条，就改哪条'
    })
  },

  pickApplicant(it) {
    if (this.busy) return
    this.busy = true
    post('/api/watch/group/api', { action: 'join_requests', conversationId: this.cid, tt: 0 }, (err, obj) => {
      if (err) { this.setRows([{ k: '没读到申请', v: String(err.msg || '读取失败') }]); return }
      const raw = (obj && obj.raw) || {}
      const list = raw.requests || raw.join_requests || raw.list || []
      if (!list.length) {
        this.setRows([{ k: '现在没人申请', v: '等有人申请了再来' }])
        return
      }
      this.pickMode = 'applicant'
      this.pendingItem = it
      this.viewRows = []
      for (let i = 0; i < list.length; i++) {
        const r = list[i] || {}
        const oid = String(r.member_openid || '')
        if (!oid) continue
        this.viewRows.push({
          k: String(r.username || '有人').slice(0, 8),
          v: '点这行选他',
          clickable: true,
          oid: oid,
          nm: String(r.username || ''),
          jid: String(r.join_request_id || '')
        })
      }
      if (!this.viewRows.length) {
        this.setRows([{ k: '没有可选的申请人', v: '申请数据里没有可用的人' }])
        return
      }
      this.viewRows.push({ k: '‹ 回去', v: '点这行回上一页', isBack: true })
      this.view = 'result'
      this.busy = false
      this.title = '选申请人'
      this.subtitle = '点谁就处理谁'
    })
  },

  tapRow(item) {
    if (!item) return
    if (item.isBack) { this.backOne(); return }
    if (item.confirmYes) {
      const it = this.pendingItem
      this.pendingItem = null
      if (it) this.run(it)
      return
    }
    if (this.pickMode === 'member') {
      this.selMember = { openid: item.oid, name: item.nm }
      this.finishPick(item.nm || '这位成员')
      return
    }
    if (this.pickMode === 'strategy') {
      this.selStrategy = { id: item.sid, label: item.slabel }
      this.finishPick('这条规则')
      return
    }
    if (this.pickMode === 'applicant') {
      this.selApplicant = { openid: item.oid, name: item.nm, jid: item.jid || '' }
      this.finishPick(item.nm || '这位')
      return
    }
  },

  finishPick(name) {
    this.pickMode = ''
    this.refreshSel()
    this.view = 'items'
    this.title = this.curGroup ? this.curGroup.label : '群管理'
    this.subtitle = this.curGroup ? (this.curGroup.desc || '') : ''
    this.viewRows = []
    const it = this.pendingItem
    this.pendingItem = null
    toast('选中了 ' + name)
    if (it) this.run(it)
  },

  sendButtons(it) {
    if (this.busy) return
    const p = BUTTON_PRESETS[it.preset] || BUTTON_PRESETS.vote
    this.busy = true
    post('/api/watch/buttons/send', {
      conversationId: this.cid,
      text: p.text,
      buttons: p.buttons,
      tt: 0
    }, (err) => {
      if (err) { this.setRows([{ k: '没发出去', v: String(err.msg || '发送失败') }]); return }
      this.setRows([
        { k: '好了', v: it.done || '已经发到群里' },
        { k: '接下来', v: '有人在 QQ 里点按钮，聊天里会告诉你' }
      ])
    })
  },

  run(it) {
    if (this.busy) return
    this.busy = true
    const payload = {
      action: it.action,
      conversationId: this.cid,
      tt: 0
    }
    if (it.memberAction) {
      payload.memberAction = it.memberAction
      payload.memberOpenid = this.selMember ? this.selMember.openid : ''
      payload.seconds = it.seconds || 0
      payload.blacklist = !!it.blacklist
    }
    if (it.action === 'approve') {
      payload.memberOpenid = this.selApplicant ? this.selApplicant.openid : ''
      payload.decision = it.decision || 'approve'
      payload.joinRequestId = this.selApplicant ? (this.selApplicant.jid || '') : ''
    }
    if (String(it.action).indexOf('strategy_') === 0 && it.action !== 'strategy_create') {
      payload.strategyId = this.selStrategy ? this.selStrategy.id : ''
      if (it.action === 'strategy_patch') payload.patch = { is_enable: 'off' }
    }
    post('/api/watch/group/api', payload, (err, obj) => {
      if (err) {
        const msg = String(err.msg || '操作失败')
        const rows = []
        if (msg.indexOf('11253') >= 0 || msg.indexOf('白名单') >= 0) {
          rows.push({ k: '没做成', v: 'QQ 不让我做这个操作' })
          rows.push({ k: '为什么', v: '这个功能要去 QQ 开放平台申请权限' })
          rows.push({ k: '怎么申请', v: '发邮件到 qq_open@tencent.com' })
          rows.push({ k: '现在能用的', v: '禁言、发通知、看群信息' })
        } else if (msg.indexOf('管理员') >= 0 || msg.indexOf('权限') >= 0) {
          rows.push({ k: '没做成', v: '我在这个群说话不算数' })
          rows.push({ k: '怎么办', v: '去 QQ 群设置里把我设成管理员' })
        } else {
          rows.push({ k: '没做成', v: msg.slice(0, 40) })
          rows.push({ k: '试试', v: '过一会儿再点一次' })
        }
        this.setRows(rows)
        return
      }
      if (it.done) {
        this.setRows([{ k: '好了', v: it.done }])
        return
      }
      const rows = this.humanRows((obj && obj.rows) || [])
      if (!rows.length) rows.push({ k: '好了', v: '已经做完' })
      this.setRows(rows)
    })
  }
}
</script>

<style>
.page { width: 336px; height: 480px; background-color: #000000; flex-direction: column; }
