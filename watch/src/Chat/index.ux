}
.quote {
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 26px;
  margin-bottom: 4px;
  padding-left: 6px;
  border-left-width: 3px;
  border-left-color: #3184d0;
  background-color: rgba(49, 132, 208, 0.12);
  border-radius: 4px;
}
.quote-t {
