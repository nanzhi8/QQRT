<import name="input-method" src="../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="ime-page">
    <div class="line" style="margin-bottom: 10px; justify-content: {{ screentype === 'circle' ? 'flex-end' : 'center' }};">
      <text static if="{{ label }}" style="margin-bottom: 4px; color: #fff;">{{ label }}</text>
      <div class="input-line" @click="finish(true)">
        <scroll style="position: absolute; width: 100%; height: {{inputScrollH}}px; margin: {{inputScrollM}}px 0" scroll-x="true">
          <text class="input-text">{{displayText}}</text>
        </scroll>
      </div>
    </div>
    <div class="page" style="flex-direction: column; height: {{screentype === 'circle' ? '225px' : (screentype === 'rect' ? '283px' : '333px')}}">
    <input-method
      hide="{{false}}"
      keyboardtype="QWERTY"
      maxlength="5"
      vibratemode="short"
      screentype="{{screentype}}"
      @complete="onComplete"
      @delete="onDelete"
    ></input-method>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { toast } from '../common/api.js'

export default {
  private: {
    context: '',
    displayText: '',
    sensitive: false,
    label: '',
    screentype: 'pill-shaped',
    inputScrollH: 42,
    inputScrollM: 6
  },

  onInit() {
    // 诊断打点（定位 S 系列闪退）：ime-init = 页面创建成功；
    // ime-ok = 初始化完成；IME初始化异常: xxx = onInit 内部报错原文。
    try { toast('ime-init') } catch (e0) {}
    // 诊断 + 韧性（4.12.4）：初始化任何一步抛异常都不允许闪退，
    // 改为 toast 显示错误文字（用户可截图回报，精确定位）。
    try {
      this.context = global.__imeText || ''
      this.sensitive = global.__imeSensitive === true
      global.__imeSensitive = false
      this.updateDisplay()
      this.label = global.__imeLabel || ''
      this.screentype = global.screenShape === 'circle' || global.screenShape === 'rect'
        ? global.screenShape : 'pill-shaped'
      if (this.screentype === 'circle') { this.inputScrollH = 30; this.inputScrollM = 2 }
      if (global.deviceProfile) this._unsubscribeDevice = global.deviceProfile.subscribe(() => {
        this.screentype = global.screenShape
      })
      try { toast('ime-ok') } catch (e0) {}
    } catch (e) {
      try { toast('IME初始化异常: ' + ((e && e.message) || e)) } catch (e2) {}
    }
  },

  onDestroy() {
    if (this._unsubscribeDevice) this._unsubscribeDevice()
  },

  onComplete(evt) {
    const content = evt && evt.detail && evt.detail.content
    if (content) this.context += String(content)
    this.updateDisplay()
  },

  onDelete() {
    this.context = this.context.slice(0, -1)
    this.updateDisplay()
  },

  updateDisplay() {
    this.displayText = this.sensitive ? this.context.replace(/[\s\S]/g, '*') : this.context
  },

  finish(confirmed) {
    global.__imeResult = { text: this.context, confirmed: confirmed }
    router.back()
  },

  onBackPress() {
    this.finish(false)
    return true
  }
}
</script>

<style>
.ime-page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #000000;
}
.line {
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 填满键盘上方的空白区域（键盘容器在文档流底部），输入行在其中居中 */
  flex-grow: 1;
  width: 100%;
}
.input-line {
  height: 54px;
  width: 256px;
  background-color: #262626;
  border: 3px solid rgba(255, 255, 255, 0.06);
  border-radius: 100%;
  align-items: center;
  justify-content: center;
}
.input-text {
  lines: 1;
  position: absolute;
  color: #fff;
  padding: 0 12px;
}
.page {
  width: 100%;
  flex-shrink: 0;
  /* 保持文档流（位于 .line 之下即屏幕底部）；relative 使其仍是内部
     绝对定位键位的定位上下文，与组件时代 absolute 的定位语义一致 */
  position: relative;
}

@media (shape: pill-shaped) {
  .line {
    padding-top: 36px;
  }
  .input-line {
    width: 88%;
  }
  .page {
    margin-bottom: 24px;
  }
}
</style>
