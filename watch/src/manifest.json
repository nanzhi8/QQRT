{
  "package": "com.qqrt.band",
  "name": "QQRT",
  "versionName": "4.11.3",
  "versionCode": 84,
  "icon": "/common/icon.png",
  "minAPILevel": 1,
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.fetch"
    },
    {
      "name": "system.router"
    },
    {
      "name": "system.prompt"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.device"
    },
    {
      "name": "system.vibrator"
    }
  ],
  "config": {
    "logLevel": "warn",
    "designWidth": 336
  },
  "display": {
    "backgroundColor": "#000000"
