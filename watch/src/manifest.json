      "Home": {
        "component": "index",
        "path": "/home"
      },
      "Chat": {
        "component": "index",
        "path": "/chat"
      },
      "Settings": {
        "component": "index",
        "path": "/settings"
      },
      "Group": {
        "component": "index",
        "path": "/group"
      },
      "Members": {
        "component": "index",
        "path": "/members"
      },
      "Requests": {
        "component": "index",
        "path": "/requests"
      },
      "Ime": {
        "component": "ime",
        "path": "/ime"
