# 数据库：进程内 PGlite 的数据目录（无需外部 Postgres）
PGLITE_DIR=./pgdata

# 数据目录：聊天缓存、手表图片/音频/视频临时文件
DATA_DIR=./data

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 单次上传大小（MB），建议 100-220
MAX_UPLOAD_MB=100

# Next.js 服务端口
PORT=3005

# 部署子路径，必须与 nginx 的 location 一致
NEXT_PUBLIC_BASE_PATH=/qqbotwatch

# 手表登录短码所用的短链服务（可选）。默认官方 https://dpaste.com/api/v2/，一般无需填写。
# 如需私有短链服务：接口需兼容 dpaste 契约（POST 表单 content=，返回纯文本 URL）。
# DPASTE_API_BASE=

# 如需允许测试环境访问内网媒体，再打开并设置；生产环境不要开启
# MEDIA_ALLOW_PRIVATE_HOSTS=

# 对外访问的完整 Origin（含协议，不带结尾斜杠）。
# 反向代理把 Host / X-Forwarded-Host 改写成内部地址时，CSRF 校验会误判为跨站，
# 表现为控制台点「保存并连接 / 常驻接收」报「跨站请求被拒绝」。
# 例：QQRT_PUBLIC_ORIGIN=https://qq.example.com
# QQRT_PUBLIC_ORIGIN=

# 额外事件订阅：1=开启群成员进出(1<<24)与按钮交互回调(1<<26)。
# 需先在 QQ 开放平台给机器人开通对应事件权限，否则网关会以 4914/4915 断开连接。
# QQRT_EXTRA_EVENTS=1
